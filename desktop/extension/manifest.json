{
  "manifest_version": 3,
  "name": "视频发布台",
  "version": "0.3.0",
  "description": "在自己的浏览器中填写抖音、百家号和大鱼号发布页，由用户确认最终发布。",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://creator.douyin.com/*", "https://baijiahao.baidu.com/*", "https://mp.dayu.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "视频发布台", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*"], "js": ["connect.js"], "run_at": "document_start" },
    { "matches": ["https://creator.douyin.com/*"], "js": ["douyin.js"], "run_at": "document_idle" },
    { "matches": ["https://baijiahao.baidu.com/*"], "js": ["baijiahao.js"], "run_at": "document_idle" },
    { "matches": ["https://mp.dayu.com/*"], "js": ["dayu.js"], "run_at": "document_idle" }
  ]
}
